# screenpipe — AI that knows everything you've seen, said, or heard; https://screenpipe.com
# ============================================================
# Abramenko Studio Telegram demo - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- REQUIRED -----

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Chat ID receiving completed demo requests
ADMIN_CHAT_ID=

# ----- DATABASE (choose one) -----

# Option A: SQLite (default, no setup needed)
# Leave DATABASE_URL empty to use SQLite at DB_PATH
DB_PATH=/app/data/nailshop.db

# Option B: PostgreSQL (recommended for production / Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# For bundled docker-compose PostgreSQL use:
# DATABASE_URL=postgresql://nailshop:changeme@db:5432/nailshop
DATABASE_URL=

# Docker Compose PostgreSQL password. Change this before production deploy.
POSTGRES_PASSWORD=changeme

# ----- OPTIONAL -----

# Timezone (IANA format)
TIMEZONE=Asia/Almaty

# Public salon information shown to clients
SALON_NAME=Abramenko Studio
SALON_PHONE=+7 707 486 5437
SALON_ADDRESS=Точный адрес уточнит администратор
SALON_WORKING_HOURS=Ежедневно: 10:00–20:00
# MASTER_NAME=Администратор Abramenko Studio

# App environment: development | production
# In production Redis FSM is required by default unless REQUIRE_REDIS_FSM=false
APP_ENV=development

# Bot runner: polling for local/dev, webhook for production deploys
BOT_MODE=polling

# Webhook settings (required when BOT_MODE=webhook)
# WEBHOOK_URL=https://your-domain.example.com
# In APP_ENV=production and BOT_MODE=webhook SECRET_TOKEN is required.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
SECRET_TOKEN=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Platform-provided port alias. Leave empty locally.
PORT=

# Polling conflict retry settings
POLLING_CONFLICT_RETRIES=24
POLLING_CONFLICT_RETRY_DELAY=5

# Redis for FSM storage (recommended for multi-instance / Railway)
# REDIS_URL=redis://:password@host:6379/0
REDIS_URL=
REQUIRE_REDIS_FSM=false

# Premium Telegram custom emoji are always enabled; Unicode fallbacks are embedded in each tag.

# Minimum minutes in advance a booking can be made (default: 60)
MIN_BOOKING_ADVANCE_MINUTES=60

# Booking/rate/loyalty limits
MAX_ACTIVE_BOOKINGS=3
MAX_BOOKING_ATTEMPTS=10
RATE_LIMIT_WINDOW=1800
LOYALTY_VISIT_INTERVAL=5
LOYALTY_DISCOUNT_PERCENT=10
REFERRAL_BONUS=100

# Phone validation (E.164 for selected country)
PHONE_COUNTRY_CODE=7
PHONE_NATIONAL_DIGITS=10

# Portfolio limits
MAX_PORTFOLIO_PHOTOS=60
MAX_PORTFOLIO_PHOTO_SIZE_BYTES=10485760

# Daily admin business digest
DAILY_DIGEST_HOUR=21
DAILY_DIGEST_MINUTE=0

# Scheduler distributed DB lock TTL for multi-instance webhook deployments
SCHEDULER_LOCK_TTL_SECONDS=120

# Local retention/anonymization policy
PRIVACY_RETENTION_DAYS=365
ADMIN_AUDIT_RETENTION_DAYS=365

# Optional S3-compatible offsite backups. Leave empty to keep local-only backups.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BACKUP_PREFIX=backups

# Disposable PostgreSQL DB used only for real restore drills of .sql.gz backups.
# Never point this at production: restore_check applies the dump to this database.
POSTGRES_RESTORE_TEST_DATABASE_URL=

# Proxy URL (if Telegram is blocked in your country)
# PROXY_URL=http://proxy.example.com:8080
PROXY_URL=

# ----- OBSERVABILITY -----
# Optional Sentry project DSN for real-time exception tracking.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=nail-tg@local
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
# Optional bearer token protecting /metrics. Configure the same token in Prometheus.
METRICS_TOKEN=

# ----- EXTERNAL CALENDAR / CRM SYNC -----
# Provider-agnostic REST endpoint. Leave empty to disable synchronization.
EXTERNAL_SYNC_URL=
# HMAC-SHA256 signing secret shared with the calendar/CRM integration.
EXTERNAL_SYNC_SECRET=
EXTERNAL_SYNC_TIMEOUT=8
EXTERNAL_SYNC_RETRIES=3
